# Copy to .env for local use. Every setting is also an environment variable (see src/nebula/config.py).

# Dev mode: no Google sign-in; every request acts as this person. Never use it on a public address.
NEBULA_AUTH_MODE=dev
NEBULA_DEV_USER_EMAIL=dev@example.org
# Accounts in these domains count as members of the organisation ("All RL").
NEBULA_ALLOWED_EMAIL_DOMAINS=example.org
NEBULA_ADMIN_EMAILS=dev@example.org

NEBULA_DATABASE_URL=postgresql://nebula:nebula@localhost:5433/nebula
NEBULA_PUBLIC_URL=http://localhost:8000

# Search models. "fake" starts instantly but only matches shared words; "local" runs the real
# multilingual models (multilingual-e5-large and bge-reranker-v2-m3, about 2.8 GB, downloaded once).
NEBULA_EMBED_PROVIDER=fake
NEBULA_RERANK_PROVIDER=none
# NEBULA_EMBED_PROVIDER=local
# NEBULA_RERANK_PROVIDER=local

# Google Drive (optional): a service account key or workload identity config, as one line of JSON.
# NEBULA_GOOGLE_SERVICE_ACCOUNT_JSON=

# Google sign-in (for a real, multi-user deployment; needs NEBULA_AUTH_MODE=google and an HTTPS address).
# NEBULA_GOOGLE_CLIENT_ID=
# NEBULA_GOOGLE_CLIENT_SECRET=
# NEBULA_JWT_SIGNING_KEY=

# Optional links in the web pages' footer.
# NEBULA_ABOUT_URL=
# NEBULA_PRIVACY_URL=
# NEBULA_TERMS_URL=
